CREATE DATABASE IF NOT EXISTS escola_solicitacoes
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE escola_solicitacoes;

-- USUÁRIOS (secretaria, gestão, admin)
CREATE TABLE usuarios (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nome VARCHAR(120) NOT NULL,
  email VARCHAR(150) NOT NULL UNIQUE,
  senha_hash VARCHAR(255) NOT NULL,
  perfil ENUM('secretaria','gestao','admin') NOT NULL DEFAULT 'secretaria',
  ativo TINYINT(1) NOT NULL DEFAULT 1,
  criado_em DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- OCORRÊNCIAS
CREATE TABLE ocorrencias (
  id INT AUTO_INCREMENT PRIMARY KEY,
  protocolo VARCHAR(20) NOT NULL UNIQUE,
  local VARCHAR(80) NOT NULL,
  categoria VARCHAR(50) NOT NULL,
  titulo VARCHAR(200) NOT NULL,
  descricao TEXT NOT NULL,
  situacao ENUM('Aguardando análise','Em andamento','Resolvida','Cancelada')
    NOT NULL DEFAULT 'Aguardando análise',
  prioridade ENUM('baixa','media','alta','urgente') NOT NULL DEFAULT 'media',
  providencias TEXT NULL,
  setor_origem ENUM('secretaria','gestao','admin') NOT NULL DEFAULT 'secretaria',
  criado_por INT NULL,
  criado_em DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  atualizado_em DATETIME NULL ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT fk_ocorr_usuario FOREIGN KEY (criado_por)
    REFERENCES usuarios(id) ON DELETE SET NULL,
  INDEX idx_situacao (situacao),
  INDEX idx_local (local),
  INDEX idx_criado_em (criado_em)
) ENGINE=InnoDB;

-- ANEXOS (1 ocorrência → N arquivos)
CREATE TABLE anexos (
  id INT AUTO_INCREMENT PRIMARY KEY,
  ocorrencia_id INT NOT NULL,
  nome_original VARCHAR(255) NOT NULL,
  nome_arquivo VARCHAR(255) NOT NULL,
  mime_type VARCHAR(100),
  tamanho_bytes INT,
  criado_em DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_anexo_ocorr FOREIGN KEY (ocorrencia_id)
    REFERENCES ocorrencias(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- HISTÓRICO / ATIVIDADES (auditoria)
CREATE TABLE atividades (
  id INT AUTO_INCREMENT PRIMARY KEY,
  ocorrencia_id INT NULL,
  setor ENUM('secretaria','gestao','admin') NOT NULL,
  usuario_id INT NULL,
  atividade VARCHAR(255) NOT NULL,
  criado_em DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_atividade_ocorr FOREIGN KEY (ocorrencia_id)
    REFERENCES ocorrencias(id) ON DELETE CASCADE,
  CONSTRAINT fk_atividade_usuario FOREIGN KEY (usuario_id)
    REFERENCES usuarios(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- COMUNICADOS
CREATE TABLE comunicados (
  id INT AUTO_INCREMENT PRIMARY KEY,
  titulo VARCHAR(200) NOT NULL,
  mensagem TEXT NOT NULL,
  autor_id INT NULL,
  publicado_em DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_comunicado_usuario FOREIGN KEY (autor_id)
    REFERENCES usuarios(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- VALIDAÇÃO INSTITUCIONAL (modo demonstração)
CREATE TABLE validacoes (
  id INT AUTO_INCREMENT PRIMARY KEY,
  ocorrencia_id INT NOT NULL,
  aprovado TINYINT(1) NOT NULL DEFAULT 1,
  observacao TEXT,
  validado_em DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_valid_ocorr FOREIGN KEY (ocorrencia_id)
    REFERENCES ocorrencias(id) ON DELETE CASCADE
) ENGINE=InnoDB;
