{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/front_end/index2.html" },
    { "src": "/index2.html", "dest": "/front_end/index2.html" },
    { "src": "/registro.html", "dest": "/front_end/registro.html" },
    { "src": "/painel.html", "dest": "/front_end/painel.html" },
    { "src": "/mapa.html", "dest": "/front_end/mapa.html" },
    { "src": "/ocorrencias.html", "dest": "/front_end/ocorrencias.html" },
    { "src": "/gestao.html", "dest": "/front_end/gestao.html" },
    { "src": "/relatorios.html", "dest": "/front_end/relatorios.html" },
    { "src": "/comunicados.html", "dest": "/front_end/comunicados.html" },
    { "src": "/recuperar.html", "dest": "/front_end/recuperar.html" },
    { "src": "/style.css", "dest": "/front_end/style.css" },
    { "src": "/script.js", "dest": "/front_end/script.js" }
  ]
}
